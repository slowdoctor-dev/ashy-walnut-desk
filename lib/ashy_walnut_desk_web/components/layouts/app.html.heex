<header class="border-b border-zinc-200 bg-white px-6 py-3">
  <div class="mx-auto flex max-w-6xl items-center justify-between">
    <div class="flex items-baseline gap-3">
      <.link navigate={~p"/"} class="text-base font-semibold text-zinc-900 hover:text-zinc-700">
        ashy-walnut-desk
      </.link>
      <span class="text-xs text-zinc-500">
        v{Application.spec(:ashy_walnut_desk, :vsn)}
      </span>
    </div>
    <div class="flex items-center gap-4 text-sm">
      <%= if assigns[:current_user] do %>
        <.link navigate={~p"/identities"} class="font-medium text-zinc-700 hover:text-zinc-900">
          {gettext("Identities")}
        </.link>
        <span class="text-zinc-500">{to_string(@current_user.email)}</span>
        <.link
          href={~p"/sign-out"}
          method="delete"
          class="font-medium text-zinc-700 hover:text-zinc-900"
        >
          {gettext("Sign out")}
        </.link>
      <% else %>
        <.link href={~p"/sign-in"} class="font-medium text-zinc-700 hover:text-zinc-900">
          {gettext("Sign in")}
        </.link>
      <% end %>
    </div>
  </div>
</header>
<main class="px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
