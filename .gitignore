# Deployment-specific config (deployer keeps in private repo)
config/deployment.exs
config/prod.secret.exs
ANTHROPIC_API_KEY*

# ─────────────────────────────────────────────────────────
# Database dumps / backups
# ─────────────────────────────────────────────────────────
*.sql
*.dump
*.backup
db_backup/
backups/

# ─────────────────────────────────────────────────────────
