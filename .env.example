# Copy this to .env and fill in actual values.
# Never commit .env.

# ─────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────
MIX_ENV=dev
PORT=4000
PHX_HOST=localhost
SECRET_KEY_BASE=  # generate: mix phx.gen.secret

# ─────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────
DATABASE_URL=ecto://postgres:postgres@localhost:5432/ashy_walnut_desk_dev
POOL_SIZE=10

# ─────────────────────────────────────────────────────────
# Anthropic API (Claude)
# ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS=4096

# ─────────────────────────────────────────────────────────
# Channel adapters (Phase 3+)
# ─────────────────────────────────────────────────────────
# Each channel adapter chosen by the deployment adds its own variables
# here. The framework does not prescribe channels. Examples a deployer
# might add:
#   MESSAGING_PROVIDER_API_KEY=
#   MESSAGING_WEBHOOK_SECRET=
#   EMAIL_PROVIDER_API_KEY=
# See specs/decisions/ADR-006 (domain as configuration).

# ─────────────────────────────────────────────────────────
# Oban (background jobs)
# ─────────────────────────────────────────────────────────
OBAN_QUEUES=default:10,messages:5,ai:3,reindex:2

# ─────────────────────────────────────────────────────────
# Telemetry / observability
# ─────────────────────────────────────────────────────────
LIVE_DASHBOARD_USERNAME=admin
LIVE_DASHBOARD_PASSWORD=

LOG_LEVEL=info
LOG_REDACT_PII=true

# ─────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────
IDENTIFIER_HASH_SALT=        # 32+ bytes hex (openssl rand -hex 32) — for hashing sensitive identifiers
ASH_AUTHENTICATION_SECRET=   # generate: mix phx.gen.secret — JWT signing secret (required in prod)
ENCRYPTION_KEY=              # for at-rest encryption of sensitive fields

# ─────────────────────────────────────────────────────────
# Feature flags
# ─────────────────────────────────────────────────────────
FEATURE_MULTI_TENANT=false       # Season 2+
